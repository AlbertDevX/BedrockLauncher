<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>BedrockLauncher</AssemblyName>
    <RootNamespace>BedrockLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>AlbertDevX</Authors>
    <Company>AlbertDevX</Company>
    <Product>BedrockLauncher</Product>
    <Description>Launcher universal para Minecraft Bedrock con autenticación Device Code Flow</Description>
    <Copyright>2026 AlbertDevX</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.2.2" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="4.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
